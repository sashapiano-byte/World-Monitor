# ---------------------------------------------------------------------------
# Russian Industrial Damage Map — environment template.
#
#   cp .env.example .env
#
# NEVER commit real credentials or API keys. Everything in this file has a
# working local default; nothing here is required to run the read-only map.
# ---------------------------------------------------------------------------

# --- Database (PostgreSQL 16 + PostGIS 3.4) -------------------------------
POSTGRES_USER=idm
POSTGRES_PASSWORD=idm_dev_password
POSTGRES_DB=industrial_damage
# Host port the Compose `db` service is published on (container port is 5432).
POSTGRES_PORT=55432

# Connection string used by the app and by db/migrate.ts.
# Inside Docker Compose this is injected automatically (host `db`).
# For `npm run dev` on the host, point at the published port:
DATABASE_URL=postgres://idm:idm_dev_password@localhost:55432/industrial_damage

# Data backend selection:
#   auto     -> use Postgres when DATABASE_URL is reachable, else the
#               version-controlled dataset in ./data (read-only fallback)
#   postgres -> require Postgres; fail loudly if unavailable
#   file     -> always read from ./data (no database needed)
DATA_BACKEND=auto

# --- Web ------------------------------------------------------------------
WEB_PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Basemap --------------------------------------------------------------
# Default basemap is OpenStreetMap raster tiles via a MapLibre style that the
# app builds locally — no key, no Google Maps dependency, no vendor lock-in.
# Set this only if you host your own vector tiles / style JSON.
#   e.g. https://tiles.example.org/styles/osm-liberty/style.json
NEXT_PUBLIC_BASEMAP_STYLE_URL=
# Attribution appended to the map. Leave as-is for stock OSM raster tiles.
NEXT_PUBLIC_BASEMAP_ATTRIBUTION=

# --- Satellite imagery (OPTIONAL, never required) -------------------------
# The repository stores LINKS and metadata for imagery, never image bytes whose
# licence forbids redistribution. See docs/SATELLITE_IMAGERY.md before enabling.
#
# Copernicus Data Space Ecosystem / Sentinel Hub OAuth client (free tier).
# Register at https://dataspace.copernicus.eu/ — keep these out of git.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
SENTINEL_HUB_INSTANCE_ID=

# --- Ingestion (OPTIONAL) --------------------------------------------------
# Shared secret required by POST /api/ingest/run. Generate a long random value.
INGEST_SECRET=
# Comma-separated RSS/Atom feeds scanned for candidate incidents.
# Candidates ALWAYS land in the manual review queue — nothing auto-publishes.
INGEST_FEEDS=
# Minimum age, in hours, before a candidate incident may even be reviewed.
# Editorial policy floor is 72; the code refuses to go below it.
INGEST_MIN_AGE_HOURS=72

# --- Building behind a TLS-intercepting proxy (OPTIONAL) ------------------
# Pass these through to `docker compose build`, e.g.
#   docker compose build --build-arg HTTPS_PROXY="$HTTPS_PROXY"
# and place the proxy's root certificate at docker/certs/ca.crt.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
