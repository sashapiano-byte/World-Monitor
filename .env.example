# ---------------------------------------------------------------------------
# Frontline — environment template. Copy to .env.local and fill in.
# NEVER commit real values. A NEW Supabase project must be created for this app
# (do not reuse Happy Hour Live's project). See DECISIONS.md.
# ---------------------------------------------------------------------------

# --- Supabase (new project) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used by ingestion route handlers / cron. Never expose to client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Mapbox ---
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-token

# --- Ingestion auth ---
# Shared secret required to trigger /api/ingest/run (Vercel cron sends this).
INGEST_SECRET=generate-a-long-random-string

# --- Data sources (Phase 1) ---
# NASA FIRMS map key (free, non-commercial-friendly). Register per DECISIONS.md.
FIRMS_MAP_KEY=
# ACLED — DO NOT populate until license decision is approved (DECISIONS.md).
ACLED_EMAIL=
ACLED_API_KEY=
# Polymarket / Kalshi are public read APIs; keys only needed for authed Kalshi.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
